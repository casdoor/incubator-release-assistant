{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EmryZhang/incubator-release-assistant/blob/main/config/release.schema.json",
  "title": "IRA Apache Casbin Go source release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "source", "release", "checks", "signing", "distribution", "votes", "runtime"],
  "properties": {
    "schemaVersion": {"const": "2"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "adapter", "incubating"],
      "properties": {
        "id": {"const": "casbin"},
        "displayName": {"const": "Apache Casbin"},
        "adapter": {"const": "casbin-go"},
        "incubating": {"const": true}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "archivePrefix"],
      "properties": {
        "repository": {"const": "https://github.com/apache/casbin.git"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "archivePrefix": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rc", "artifactBaseName"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-incubating$"},
        "rc": {"type": "integer", "minimum": 1},
        "artifactBaseName": {"type": "string", "pattern": "^apache-casbin-[0-9]+\\.[0-9]+\\.[0-9]+-incubating-src$"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFiles", "rat"],
      "properties": {
        "requiredFiles": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "allOf": [
            {"contains": {"const": "LICENSE"}},
            {"contains": {"const": "NOTICE"}},
            {"contains": {"enum": ["DISCLAIMER", "DISCLAIMER-WIP"]}},
            {"contains": {"const": "go.mod"}},
            {"contains": {"const": "go.sum"}},
            {"contains": {"const": ".rat-excludes"}}
          ]
        },
        "rat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "version", "excludeFile"],
          "properties": {
            "enabled": {"const": true},
            "version": {"const": "0.18"},
            "excludeFile": {"const": ".rat-excludes"}
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apacheId", "fingerprint", "keysUrl", "requireApacheUid", "minimumRsaBits"],
      "properties": {
        "apacheId": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "keysUrl": {"const": "https://dist.apache.org/repos/dist/release/incubator/casbin/KEYS"},
        "requireApacheUid": {"const": true},
        "minimumRsaBits": {"type": "integer", "minimum": 4096}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devUrl", "releaseUrl"],
      "properties": {
        "devUrl": {"const": "https://dist.apache.org/repos/dist/dev/incubator/casbin"},
        "releaseUrl": {"const": "https://dist.apache.org/repos/dist/release/incubator/casbin"}
      }
    },
    "votes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devList", "generalList", "minimumHours"],
      "properties": {
        "devList": {"const": "dev@casbin.apache.org"},
        "generalList": {"const": "general@incubator.apache.org"},
        "minimumHours": {"type": "integer", "minimum": 72}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateDirectory", "container"],
      "properties": {
        "stateDirectory": {"const": ".ira"},
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "image", "network"],
          "properties": {
            "engine": {"enum": ["docker", "podman"]},
            "image": {"const": "golang:1.24"},
            "network": {"enum": ["default", "none"]}
          }
        }
      }
    }
  }
}
