# Local release configuration and credentials
.env
.env.*
!.env.example
**/release.local.json
config/local/
config/**/*.local.json
script.egg
.ira/

# Private keys and credential stores (defence in depth; never rely on ignore alone)
*.pem
*.key
*.p12
*.pfx
*.kbx
.gnupg/
**/private-keys-v1.d/
secretkey/
**/secretkey/
credentials.json
auth.json
.npmrc
.pypirc

# Generated release work and downloaded tools
artifacts/
downloads/
**/work/
**/output/
**/evidence/
**/tools/
**/dist-dev/
**/public-download/

# Release artifacts must live in ASF distribution, not this repository
*.tar.gz
*.zip
*.asc
*.sha512
rat-report*.txt

# Language and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
node_modules/
.gocache/
.gomodcache/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp
