{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EmryZhang/incubator-release-assistant/blob/main/config/release.schema.json",
  "title": "Apache Incubator source release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "source",
    "release",
    "checks",
    "signing",
    "distribution",
    "votes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "language", "incubating"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "displayName": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "incubating": {"type": "boolean"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "archivePrefix"],
      "properties": {
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "archivePrefix": {"type": "string", "minLength": 1}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rc", "artifactBaseName"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "rc": {"type": "integer", "minimum": 1},
        "artifactBaseName": {"type": "string", "minLength": 1}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFiles", "commands", "rat"],
      "properties": {
        "requiredFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "run"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "run": {"type": "string", "minLength": 1},
              "workingDirectory": {"type": "string", "minLength": 1}
            }
          }
        },
        "rat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "version"],
          "properties": {
            "enabled": {"type": "boolean"},
            "version": {"type": "string", "minLength": 1},
            "excludeFile": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apacheId", "fingerprint", "keysUrl", "requireApacheUid", "minimumRsaBits"],
      "properties": {
        "apacheId": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "keysUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "requireApacheUid": {"type": "boolean"},
        "minimumRsaBits": {"type": "integer", "minimum": 2048}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devUrl", "releaseUrl"],
      "properties": {
        "devUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "releaseUrl": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "votes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devList", "generalList", "minimumHours"],
      "properties": {
        "devList": {"type": "string", "format": "email"},
        "generalList": {"type": "string", "format": "email"},
        "minimumHours": {"type": "integer", "minimum": 72}
      }
    }
  }
}
